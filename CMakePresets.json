{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC 15 Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++-15",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC 15 Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++-15",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang 21 Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++-21",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Clang 21 Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++-21",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "gcc-release", "configurePreset": "gcc-release" },
    { "name": "gcc-debug", "configurePreset": "gcc-debug" },
    { "name": "clang-release", "configurePreset": "clang-release" },
    { "name": "clang-debug", "configurePreset": "clang-debug" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true }
    },
    { "name": "gcc-release", "configurePreset": "gcc-release", "inherits": "base" },
    { "name": "gcc-debug", "configurePreset": "gcc-debug", "inherits": "base" },
    { "name": "clang-release", "configurePreset": "clang-release", "inherits": "base" },
    { "name": "clang-debug", "configurePreset": "clang-debug", "inherits": "base" }
  ]
}
